#: options/class.WpdiscuzOptions.php:1071
msgid "Hi [FOLLOWER_NAME],<br/><br/> new comment has been posted by the <em><strong>[COMMENT_AUTHOR]</em></strong> you are following<br/><br/><a href=\"[COMMENT_URL]\">[COMMENT_URL]</a><br/><br/>[COMMENT_CONTENT]<br/><br/><a href=\"[CANCEL_URL]\">Unfollow</a>"
msgstr "درود [FOLLOWER_NAME],<br/><br/> دیدگاه جدیدی که شما <em><strong>[COMMENT_AUTHOR]</em></strong> دنبال می‌کنید، ارسال شد<br/><br/><a href=\"[COMMENT_URL]\">[COMMENT_URL]</a><br/><br/>[COMMENT_CONTENT]<br/><br/><a href=\"[CANCEL_URL]\">عدم دنبال‌کردن</a>"

#: options/class.WpdiscuzOptions.php:1069
msgid "Hi, <br/> You just started following a new user. You'll get email notification once new comment is posted by this user. <br/> Please click on \"user following confirmation\" link to confirm your request. If you believe this is an error, ignore this message and we'll never bother you again. <br/><br/><a href=\"[POST_URL]\">[POST_TITLE]</a><br/><br/><a href=\"[CONFIRM_URL]\">Confirm Follow</a><br/><br/><a href=\"[CANCEL_URL]\">Unfollow</a>"
msgstr "درود <br/> شما به تازگی کاربر جدیدی را دنبال کرده اید. پس از ارسال نظر جدید توسط این کاربر، اعلان ایمیل دریافت خواهید کرد. <br/> لطفاً برای تأیید درخواست خود روی پیوند \"کاربر به دنبال تایید\" کلیک کنید. اگر فکر می‌کنید این یک خطا است، این پیام را نادیده بگیرید و دیگر هرگز مزاحم شما نخواهیم شد. <br/><br/><a href=\"[POST_URL]\">[POST_TITLE]</a><br/><br/><a href=\"[CONFIRM_URL]\">عدم دنبال کردن</a><br/><br/><a href=\"[CANCEL_URL]\">Unfollow</a>"

