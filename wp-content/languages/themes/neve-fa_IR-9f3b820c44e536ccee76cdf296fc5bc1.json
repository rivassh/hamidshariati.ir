46\u062f\u0627\u062e\u062a\u0646\u060c \u062e\u0648\u0627\u0647\u06cc\u062f \u06cc\u0627\u0641\u062a."],"Build a landing page with a drag-and-drop content builder":["\u0628\u0627 \u06cc\u06a9 \u06a9\u0634\u06cc\u062f\u0646 \u0648 \u0627\u0646\u062f\u0627\u062e\u062a\u0646 \u0633\u0627\u0632\u0646\u062f\u0647 \u0645\u062d\u062a\u0648\u0627\u060c \u06cc\u06a9 \u0635\u0641\u062d\u0647 \u0641\u0631\u0648\u062f \u0627\u06cc\u062c\u0627\u062f \u06a9\u0646\u06cc\u062f"],"If you find yourself in a situation where everything on your site is running very slowly, you might consider having a look at the documentation below where you will find the most common issues causing this and possible solutions for each of the issues.":["\u0627\u06af\u0631 \u0627\u062d\u0633\u0627\u0633 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u062f \u06a9\u0647 \u0633\u0627\u06cc\u062a \u0634\u0645\u0627 \u0628\u0633\u06cc\u0627\u0631 \u06a9\u0646\u062f \u0634\u062f\u0647 \u0627\u0633\u062a\u060c \u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0632\u06cc\u0631 \u0631\u0627 \u0645\u0637\u0627\u0644\u0639\u0647 \u06a9\u0646\u06cc\u062f\u061b \u062f\u0631 \u0627\u06cc\u0646 \u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0628\u0647 \u0645\u0648\u0627\u0631\u062f\u06cc \u06a9\u0647 \u0645\u0639\u0645\u0648\u0644\u0627 \u0628\u0627\u0639\u062b \u0627\u06cc\u0646 \u0645\u0634\u06a9\u0644 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f \u0648 \u0631\u0627\u0647\u2006\u062d\u0644\u200c\u0647\u0627\u06cc \u0627\u062d\u062a\u0645\u0627\u0644\u06cc \u0628\u0631\u0627\u06cc \u0647\u0631 \u0645\u0648\u0631\u062f \u067e\u0631\u062f\u0627\u062e\u062a\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a."],"Speed up your site":["\u0628\u0647\u0628\u0648\u062f \u0633\u0631\u0639\u062a \u0633\u0627\u06cc\u062a"],"If you want to make changes to the theme's files, those changes are likely to be overwritten when you next update the theme. In order to prevent that from happening, you need to create a child theme. For this, please follow the documentation below.":["\u0627\u06af\u0631 \u0645\u06cc \u062e\u0648\u0627\u0647\u06cc\u062f \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u062f\u0631 \u0641\u0627\u06cc\u0644 \u0647\u0627\u06cc \u067e\u0648\u0633\u062a\u0647 \u0627\u06cc\u062c\u0627\u062f \u06a9\u0646\u06cc\u062f\u060c \u0627\u06cc\u0646 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0627\u062d\u062a\u0645\u0627\u0644\u0627 \u062f\u0631 \u0647\u0646\u06af\u0627\u0645 \u0628\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u0628\u0639\u062f\u06cc\u060c \u062f\u0648\u0628\u0627\u0631\u0647 \u0646\u0648\u06cc\u0633\u06cc \u062e\u0648\u0627\u0647\u0646\u062f \u0634\u062f. \u0628\u0631\u0627\u06cc \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u0627\u06cc\u0646 \u0627\u062a\u0641\u0627\u0642\u060c \u0634\u0645\u0627 \u0628\u0627\u06cc\u062f \u06cc\u06a9 \u067e\u0648\u0633\u062a\u0647 \u0641\u0631\u0632\u0646\u062f \u0627\u06cc\u062c\u0627\u062f \u06a9\u0646\u06cc\u062f. \u0628\u0631\u0627\u06cc \u0627\u06cc\u0646 \u06a9\u0627\u0631\u060c \u0644\u0637\u0641\u0627 \u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0632\u06cc\u0631 \u0631\u0627 \u062f\u0646\u0628\u0627\u0644 \u06a9\u0646\u06cc\u062f."],"Create a child theme":["\u0627\u06cc\u062c\u0627\u062f \u06cc\u06a9 \u067e\u0648\u0633\u062a\u0647 \u0641\u0631\u0632\u0646\u062f"],"Want to get the gist on the latest theme changes? Just consult our changelog below to get a taste of the recent fixes and features implemented.":["\u0645\u06cc\u062e\u0648\u0627\u0647\u06cc\u062f \u062e\u0644\u0627\u0635\u0647 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0627\u062e\u06cc\u0631 \u0628\u06af\u06cc\u0631\u06cc\u062f\u061f \u0622\u062e\u0631\u06cc\u0646 \u06af\u0632\u0627\u0631\u0634 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0645\u0627 \u0631\u0627 \u062f\u0631 \u0632\u06cc\u0631 \u0628\u062e\u0648\u0627\u0646\u06cc\u062f \u062a\u0627 \u0637\u0639\u0645 \u0631\u0641\u0639 \u0648 \u0648\u06cc\u0698\u06af\u06cc \u0647\u0627\u06cc \u0627\u062e\u06cc\u0631 \u0631\u0627 \u0