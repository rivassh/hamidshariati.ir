		<title>تا حالا آفلاین داکر کار کردی؟</title>
		<link>./../../../2024/02/13/%d8%aa%d8%a7-%d8%ad%d8%a7%d9%84%d8%a7-%d8%a2%d9%81%d9%84%d8%a7%db%8c%d9%86-%d8%af%d8%a7%da%a9%d8%b1-%da%a9%d8%a7%d8%b1-%da%a9%d8%b1%d8%af%db%8c%d8%9f/index.html</link>
					<comments>./../../../2024/02/13/%d8%aa%d8%a7-%d8%ad%d8%a7%d9%84%d8%a7-%d8%a2%d9%81%d9%84%d8%a7%db%8c%d9%86-%d8%af%d8%a7%da%a9%d8%b1-%da%a9%d8%a7%d8%b1-%da%a9%d8%b1%d8%af%db%8c%d8%9f/index.html#respond</comments>
		
