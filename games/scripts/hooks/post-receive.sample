#!/usr/bin/env bash
# Git post-receive hook (sample) — auto-deploy WebGL when a version tag is pushed.
# Install: cp post-receive.sample /opt/games/<game>/repo/.git/hooks/post-receive && chmod +x
#
set -euo pipefail

GAMES_ROOT="/opt/games"
GAME_NAME="$(basename "$(dirname "$(dirname "$PWD")")")"
DEPLOY_SCRIPT="/opt/scripts/deploy-game.sh"
UPLOAD_DIR="$GAMES_ROOT/$GAME_NAME/upload"

# GAME_NAME = parent of repo (…/game1/repo → game1)
GAME_NAME="$(basename "$(dirname "$(dirname "$(readlink -f "$0")")")")"

while read -r oldrev newrev ref; do
  ref="${ref#refs/}"
  if [[ "$ref" == tags/* ]]; then
    VERSION="${ref#tags/}"
    if [[ -f "$UPLOAD_DIR/index.html" ]]; then
      echo "Deploying $GAME_NAME $VERSION from $UPLOAD_DIR"
      "$DEPLOY_SCRIPT" "$GAME_NAME" "$VERSION"
    else
      echo "Skip: upload WebGL to $UPLOAD_DIR first"
    fi
  fi
done
